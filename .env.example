# Auth.js — set all values in Vercel's dashboard; never commit real values.
AUTH_SECRET=generate-a-long-random-value
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public GitHub numeric ID for the only allowed admin account.
AUTH_GITHUB_ALLOWED_USER_ID=71895533

# Supabase Data API. The publishable key is safe for anonymous clients only
# when the database RLS policies in supabase/migrations are applied.
# Both values come from Project Settings -> API Keys (NOT the "Data API"
# integrations page, which only shows the REST URL, not the actual keys).
# As of Aug 2026, Supabase renamed the classic anon/service_role JWT keys:
# the API Keys page defaults to a "Publishable and secret API keys" tab.
# NEXT_PUBLIC_SUPABASE_URL is the plain Project URL (no /rest/v1/ suffix).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is the "Publishable key" (sb_publishable_...)
# on that tab -- this replaces the old "anon" key, same purpose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase Transaction Pooler, server-only. Use the host/credentials from
# Supabase's Connect panel; do not replace these with a DATABASE_URL string.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# Server-only Supabase key, if needed for maintenance tasks. Never prefix it
# with NEXT_PUBLIC_ and never import its module from a client component.
# Variable name is the classic Supabase convention and deliberately kept --
# but the VALUE should be the new "Secret key" (sb_secret_...) from the
# "Publishable and secret API keys" tab (eye icon to reveal it), not the
# old service_role JWT under the separate "Legacy" tab. Same privilege
# level, new format -- see docs/PLAN.md's Phase 2 prerequisites for why.
SUPABASE_SERVICE_ROLE_KEY=
